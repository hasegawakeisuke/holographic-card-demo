{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokecard-hands",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // 静的アセット（public/）を配信。アセットに一致しないリクエストだけ Worker が処理する。
  // not_found_handling は既定の "none" のまま = /api/* が Worker に届く。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // docs/ 配下の HTML を「文字列」としてバンドルに取り込む設定。
  // これにより本体を docs/ に置いたまま、Worker から配信できる（src/app.ts 参照）。
  // public/ に複製を置かずに済むので、ファイルの実体は常に1つ。
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": false
    }
  ],

  "observability": {
    "enabled": true
  }
}
